{
  "proseWrap": "never",
  "overrides": [
    {
      "files": ["COMMIT_EDITMSG", "TAG_EDITMSG"],
      "options": {
        "parser": "markdown",
        "printWidth": 72,
        "proseWrap": "always"
      }
    },
    {
      "files": ["docs/**/*.md"],
      "options": {
        "parser": "markdown",
        "tabWidth": 4
      }
    },
    {
      "files": ["*.y*ml", "changelog.md"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
